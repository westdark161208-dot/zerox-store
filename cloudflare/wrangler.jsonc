{
  "name": "zerox-sixofire-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "PUBLIC_COMMERCE_ENABLED": "true",
    "SIXOFIRE_DELIVERY_ENABLED": "true",
    "MP_COLLECTOR_ID_PRODUCTION": "1404826494",
    "MP_PRODUCTION_READ_ENABLED": "true",
    "MP_WALLET_PILOT_ENABLED": "true",
    "WALLET_READ_ENABLED": "true",
    "RA_READ_ENABLED": "false",
    "RA_AUTO_ASSOCIATE_US": "false",
    "RA_CONTRACT_VERIFIED": "false",
    "RA_DELIVERY_ENABLED": "false",
    "DIAMOND_PRODUCTION_ENABLED": "false",
    "MP_PRODUCT_QUOTES_V3": "true",
    "MP_FUNDING_QUOTES_V3": "true",
    "MP_FEE_POLICY_VERIFIED": "true",
    "MP_FEE_POLICY_VERSION": "mx-checkout-349-400-iva16-20261010",
    "MP_FEE_RATE_BPS": "349",
    "MP_FEE_FIXED_CENTS": "400",
    "MP_FEE_TAX_BPS": "1600",
    "RA_ADMIN_READ_ENABLED": "true",
    "RA_ADMIN_READ_TRANSPORT": "service-binding",
    "RA_ADMIN_READ_CONTRACT_VERIFIED": "false",
    "RA_FF110_PILOT_ONLY": "true",
    "RA_FF110_WALLET_ONLY": "true",
    "RA_FF110_PURCHASE_ENABLED": "false",
    "RA_FF110_PRODUCT_VERIFIED": "false",
    "RA_FF110_CONTRACT_VERIFIED": "false",
    "RA_DIAMOND_PACKS": "{\"110\":{\"productId\":5,\"sku\":\"ADS005\",\"name\":\"Recarga Free Fire - 100 Diamantes + 10% Bono\",\"baseDiamonds\":100,\"bonusDiamonds\":10,\"regions\":[\"US\"],\"playerField\":\"player_id\",\"bonusEvidence\":\"Historical ADS005 catalog; requires approval and live revalidation before activation\"}}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zerox-store-db",
      "database_id": "56da67bb-a83e-4b29-8193-eb3baf0cb404"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zerox-store-media"
    }
  ],
  "services": [
    {
      "binding": "RA_READ_SERVICE",
      "service": "zerox-ra-vpc-test"
    },
    {
      "binding": "RA_PURCHASE_SERVICE",
      "service": "zerox-ra-purchase-bridge"
    }
  ]
}
