{
  "name": "zerox-ra-founder-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "services": [
    {
      "binding": "RA_READ_SERVICE",
      "service": "zerox-ra-vpc-test"
    }
  ],
  "vars": {
    "STAGING_READ_ONLY": "true",
    "RA_ADMIN_READ_ENABLED": "true",
    "RA_ADMIN_READ_TRANSPORT": "service-binding",
    "RA_ADMIN_READ_CONTRACT_VERIFIED": "true",
    "RA_READ_ENABLED": "false",
    "RA_AUTO_ASSOCIATE_US": "false",
    "RA_DELIVERY_ENABLED": "false",
    "RA_CONTRACT_VERIFIED": "false",
    "DIAMOND_PRODUCTION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "STAGING_AUTH_DB",
      "database_name": "zerox-ra-founder-staging-auth",
      "database_id": "a54b8020-71a4-4d4d-a576-800ee112a5cf"
    }
  ]
}
